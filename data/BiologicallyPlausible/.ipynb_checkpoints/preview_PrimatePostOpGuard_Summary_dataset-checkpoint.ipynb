    "# preview_raw_dataset.ipynb\n",
    "import pandas as pd\n",
    "\n",
    "# Load the raw dataset\n",
    "df = pd.read_csv(\"PrimatePostOpGuard_Summary.csv\")\n",
    "\n",
    "# Round all numeric columns to 2 decimals for display\n",
    "numeric_cols = df.select_dtypes(include='number').columns\n",
    "\n",
    "# Show all rows and columns\n",
    "pd.set_option('display.max_rows', None)\n",
    "pd.set_option('display.max_columns', None)\n",
    "pd.set_option('display.width', None)\n",
    "\n",
    "# Display nicely rounded\n",
    "df.style.format({col: \"{:.2f}\" for col in numeric_cols}) \\\n",
    "        .set_table_attributes('style=\"font-size:12px\"')"
